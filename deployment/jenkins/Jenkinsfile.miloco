pipeline {
    agent { label 'micamera-build' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }
    environment {
        MICAMERA_SERVICE = 'miloco'
    }
    stages {
        stage('Clean') {
            steps { deleteDir() }
        }
        stage('Pull Code') {
            steps {
                checkout scm
                sh 'test "$(git branch --show-current)" = develop || test "$(git rev-parse HEAD)" = "$(git rev-parse origin/develop)"'
            }
        }
        stage('Restore Dependencies') {
            steps { sh 'python3 deployment/jenkins/ci.py "$MICAMERA_SERVICE" dependencies' }
        }
        stage('Build Project') {
            steps { sh 'python3 deployment/jenkins/ci.py "$MICAMERA_SERVICE" build' }
        }
        stage('Create Container Image') {
            steps { sh 'python3 deployment/jenkins/ci.py "$MICAMERA_SERVICE" image' }
        }
        stage('Export and Upload Image to Server') {
            steps {
                sh 'python3 deployment/jenkins/ci.py "$MICAMERA_SERVICE" export'
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'micamera-deploy-104', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'micamera-deploy-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    sh 'python3 deployment/jenkins/ci.py "$MICAMERA_SERVICE" upload'
                }
            }
        }
        stage('Run Container on Server') {
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'micamera-deploy-104', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'micamera-deploy-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    sh 'python3 deployment/jenkins/ci.py "$MICAMERA_SERVICE" run'
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts(artifacts: 'deployment/build_output/jenkins/manifest.json,deployment/build_output/jenkins/SHA256SUMS', allowEmptyArchive: true)
        }
    }
}

